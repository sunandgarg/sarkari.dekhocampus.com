# Public browser configuration. Production uses the existing DekhoCampus AWS API.
VITE_API_URL=https://aws-origin.dekhocampus.com
VITE_AWS_API_URL=https://aws-origin.dekhocampus.com
VITE_MEDIA_BASE_URL=https://cdn.dekhocampus.com
VITE_ALERT_CHANNEL_URL=

# Build-time sitemap configuration.
SITEMAP_API_URL=https://aws-origin.dekhocampus.com
SITEMAP_BASE_URL=https://sarkari.dekhocampus.com
# Offline local builds may explicitly opt into a fixed-routes-only sitemap.
# This escape hatch is ignored in production.
# SITEMAP_MODE=development
# SITEMAP_ALLOW_MISSING_ARTICLE_API=true
