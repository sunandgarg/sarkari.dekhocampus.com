# The public Sarkari repository intentionally contains only the frontend and
# its deployment path. These inherited workspace folders remain local because
# they include unrelated backend, research, export, and infrastructure data.
.env
.dockerignore
/api/
/backend/
/data/
/db-export/
/docs/
/functions/*
!/functions/_middleware.ts
!/functions/news/
/functions/news/*
!/functions/news/\[slug\].ts
/infra/
/reports/
/supabase/
/workers/
.github/workflows/backup-digitalocean.yml
.github/workflows/deploy-aws-lightsail.yml
.github/workflows/deploy-cloudflare-pages.yml
scripts/*
!scripts/apply-site-metadata.ts
!scripts/check-no-large-dashes.mjs
!scripts/deploy-prod.sh
!scripts/generate-brand-icons.mjs
!scripts/generate-sitemap.ts

